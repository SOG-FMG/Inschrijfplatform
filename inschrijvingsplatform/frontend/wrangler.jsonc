{
  "name": "fmg-inschrijfplatform",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Enkel /api/* gaat eerst naar de Worker; al de rest komt rechtstreeks uit de assets.
    "run_worker_first": ["/api/*"]
  },
  // De API-Worker (backend/wrangler.toml, name = "inschrijvingsplatform-api").
  "services": [{ "binding": "API", "service": "inschrijvingsplatform-api" }]
}
